# Copy to .env and set a long random token. The Cloudflare Worker sends this as `Authorization: Bearer <token>`.
SANDBOX_TOKEN=change-me-to-a-long-random-string
PORT=8080
# How many pages may be scanned at once. 3 is comfortable on a 2 vCPU / 4 GB VPS.
MAX_CONCURRENT=3
# Hard ceiling for one scan, in ms.
SCAN_TIMEOUT_MS=30000
