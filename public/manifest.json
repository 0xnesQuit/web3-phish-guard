{
  "manifest_version": 3,
  "name": "Web3 Phish Guard",
  "version": "0.1.0",
  "description": "Sahte NFT mint ve airdrop claim sayfalarına karşı anlık uyarı. Tüm kontroller yerel çalışır.",
  "permissions": ["storage", "unlimitedStorage", "alarms", "webNavigation", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Web3 Phish Guard" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["provider-guard.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["overlay.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [{ "resources": ["warning.html"], "matches": ["<all_urls>"] }],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
